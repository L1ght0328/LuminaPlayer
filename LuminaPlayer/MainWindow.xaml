<Window x:Class="LuminaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina Player" Icon="pack://application:,,,/lumina.ico"
        Height="820" Width="1440" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI" FontSize="13"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#100D1B"/>
        <SolidColorBrush x:Key="PanelBg" Color="#E6191428"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#E6241D38"/>
        <SolidColorBrush x:Key="RaisedBg" Color="#FF30234A"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F8F5FF"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#BDB3D0"/>
        <SolidColorBrush x:Key="Accent" Color="#B65CFF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#49306D"/>
        <SolidColorBrush x:Key="Line" Color="#49365F"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#503D6A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="itemBorder" Background="Transparent" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#593477"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#38284E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="Foreground" Value="#241832"/><Setter Property="Padding" Value="7,4"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
        <!-- Header -->
        <Grid Grid.Row="0" Margin="4,0,4,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="7,0,0,0">
                <TextBlock Text="〽" FontSize="36" Foreground="{DynamicResource Accent}" FontWeight="Bold" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="LUMINA" FontSize="21" FontWeight="Bold"/><TextBlock Text="PLAYER" FontSize="9" Foreground="{DynamicResource SecondaryText}"/></StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22" Height="42" VerticalAlignment="Center" Margin="12,0,14,0">
                <DockPanel><TextBlock Text="⌕" FontSize="25" Foreground="{DynamicResource SecondaryText}" Margin="14,0,7,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Buscar músicas, artistas e álbuns"/></DockPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="＋ Adicionar pasta" Background="{DynamicResource Accent}" Foreground="#1B1029" Click="AddFolder_Click" Padding="15,11"/><Button Content="☰" FontSize="18" Width="42" Click="Menu_Click" ToolTip="Menu, aparência e configurações"/></StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="198"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="17" Padding="11" Margin="0,0,10,9">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="BIBLIOTECA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="9,8,0,10"/>
                    <StackPanel Grid.Row="1">
                        <Button Content="♫   Minha Música" HorizontalContentAlignment="Left" Background="{DynamicResource AccentSoft}" Click="AllMusic_Click"/>
                        <Button Content="◉   Explorar" HorizontalContentAlignment="Left" Click="TabAll_Click"/>
                        <Button Content="☷   Playlists" HorizontalContentAlignment="Left" Click="Playlists_Click"/>
                        <Button Content="♙   Artistas" HorizontalContentAlignment="Left" Click="TabArtists_Click"/>
                        <Button Content="◉   Álbuns" HorizontalContentAlignment="Left" Click="TabAlbums_Click"/>
                        <Button Content="♫   Gêneros" HorizontalContentAlignment="Left" Click="TabGenres_Click"/>
                        <Button Content="▱   Pastas" HorizontalContentAlignment="Left" Click="FocusFolders_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,15,0,0"><Border Height="1" Background="{DynamicResource Line}" Margin="5,0,5,9"/><TextBlock Text="SUAS PASTAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="9,0,0,5"/><ListBox x:Name="RootsList" MaxHeight="150" MouseDoubleClick="Root_DoubleClick" SelectionChanged="Root_SelectionChanged"/><TextBlock Text="PLAYLISTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="9,14,0,5"/><ListBox x:Name="CollectionsList" MouseDoubleClick="Collection_DoubleClick" SelectionChanged="Collection_SelectionChanged"/>
                        <Grid Margin="2,5,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="+ Playlist" Click="NewPlaylist_Click" Padding="4,5"/><Button Grid.Column="1" Content="+ Categoria" Click="NewGroup_Click" Padding="4,5"/></Grid></StackPanel>
                    <StackPanel Grid.Row="3"><Border Height="1" Background="{DynamicResource Line}" Margin="5,8"/><Button Content="☷   Equalizador" HorizontalContentAlignment="Left" Click="ShowEqualizer_Click"/><Button Content="◐   Aparência" HorizontalContentAlignment="Left" Click="Menu_Click"/><TextBlock Text="OFFLINE · SUA MÚSICA" FontSize="9" Foreground="{DynamicResource SecondaryText}" Margin="9,10,0,2"/></StackPanel>
                </Grid>
            </Border>

            <!-- Center -->
            <Grid Grid.Column="1" Margin="0,0,10,9">
                <Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="42"/><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="17" Padding="24,16" Margin="0,0,0,9" ClipToBounds="True">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#552080" Offset="0"/><GradientStop Color="#2A1648" Offset="0.57"/><GradientStop Color="#171126" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="BOA MÚSICA, SEMPRE." FontSize="26" FontWeight="Bold"/><TextBlock Text="Sua biblioteca, do seu jeito." FontSize="15" Foreground="#D6C8E9" Margin="0,5,0,0"/></StackPanel><Path Data="M0,35 C20,5 30,70 50,28 S80,15 100,60" Stroke="#C05AFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="95" Height="68" Stretch="Fill" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"/></Grid>
                </Border>
                <Grid Grid.Row="1" Margin="1,0,1,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="TabAll" Content="Todas" Background="{DynamicResource AccentSoft}" Padding="15,6" Click="TabAll_Click"/><Button x:Name="TabMusic" Content="Músicas" Padding="13,6" Click="TabMusic_Click"/><Button x:Name="TabAlbums" Content="Álbuns" Padding="13,6" Click="TabAlbums_Click"/><Button x:Name="TabArtists" Content="Artistas" Padding="13,6" Click="TabArtists_Click"/><Button x:Name="TabGenres" Content="Gêneros" Padding="13,6" Click="TabGenres_Click"/><Button x:Name="TabFolders" Content="Pastas" Padding="13,6" Click="TabFolders_Click"/></StackPanel><TextBlock x:Name="TrackCount" Grid.Column="1" Text="0 faixas" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,7,0"/></Grid>
                <Grid Grid.Row="2" Margin="2,0,2,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SUA COLEÇÃO MUSICAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="StatusText" Text="Adicione uma pasta para começar" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TrackPageLabel" Text="1 / 1" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,5,0"/><Button Content="‹" Padding="7,3" Click="PreviousPage_Click"/><Button Content="›" Padding="7,3" Click="NextPage_Click"/><Button Content="▶ Tocar tudo" Padding="8,3" Click="PlayAll_Click"/><Button Content="＋ Pasta" Padding="8,3" Click="AddFolder_Click"/></StackPanel></Grid>
                <Grid Grid.Row="3">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="75"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <ItemsControl x:Name="FolderTiles" Grid.Row="0" Margin="0,0,0,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Height="64" Margin="3" Padding="10,7" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Click="FolderTile_Click" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="▰" FontSize="27" Foreground="{DynamicResource Accent}" Margin="0,0,9,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Width="100"/><TextBlock Text="{Binding CountLabel}" FontSize="9" Foreground="{DynamicResource SecondaryText}"/></StackPanel></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Grid Grid.Row="1"><ListBox x:Name="TracksList" MouseDoubleClick="Track_DoubleClick" SelectionMode="Extended"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Button Click="TrackCard_Click" ToolTip="Clique para reproduzir esta música" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="8" Margin="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border CornerRadius="9" ClipToBounds="True" Background="{Binding CoverBrush}" MinHeight="105"><Grid><Image Source="{Binding CoverPath}" Stretch="UniformToFill"/><TextBlock Text="♫" FontSize="38" Foreground="#F2E6FF" Opacity="0.88" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CoverPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Background="#880D0815" CornerRadius="20" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5"><TextBlock Text="▶" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border><StackPanel Grid.Row="1" Margin="2,7,2,1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" FontSize="10" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Album}" FontSize="9" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Adicione uma pasta para começar a ouvir sua coleção" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=TracksList, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Right rail -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="17" Padding="11" Margin="0,0,0,9">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="TOCANDO AGORA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="4,4,0,10"/>
                    <Border Height="142" CornerRadius="13" ClipToBounds="True" Background="#38204F"><Grid><Image x:Name="NowCover" Stretch="UniformToFill"/><TextBlock x:Name="NowCoverGlyph" Text="〽" FontSize="72" Foreground="#E1B9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="LUMINA PLAYER" FontSize="8" Foreground="#EBD9FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,7"/></Grid></Border>
                    <TextBlock x:Name="NowPlaying" Text="Escolha uma música" FontSize="17" FontWeight="Bold" Margin="2,10,2,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="NowArtist" Text="Biblioteca local" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="2,1,2,0"/><TextBlock x:Name="NowAlbum" Text="Offline" Foreground="{DynamicResource SecondaryText}" FontSize="10" Margin="2,0,2,8"/>
                    <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="Duration" Grid.Column="1" Text="0:00" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></Grid>
                    <Slider x:Name="Progress" Minimum="0" Maximum="1000" ValueChanged="Progress_ValueChanged" PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="⤨" Click="Shuffle_Click"/><Button Grid.Column="1" Content="|◀" FontSize="17" Click="Previous_Click"/><Button Grid.Column="2" x:Name="PlayButton" Content="▶" FontSize="19" Width="42" Height="42" Background="{DynamicResource Accent}" Foreground="#1B1029" Click="PlayPause_Click"/><Button Grid.Column="3" Content="▶|" FontSize="17" Click="Next_Click"/><Button Grid.Column="4" x:Name="LoopButton" Content="↻" Click="Loop_Click" ToolTip="Repetir"/></Grid>
                    <Border x:Name="VisualizerCard" Background="{DynamicResource SurfaceBg}" CornerRadius="10" Padding="8" Margin="0,0,0,8"><UniformGrid x:Name="VisualizerBars" Rows="1" Columns="20" Height="31" VerticalAlignment="Center"><Rectangle Fill="{DynamicResource Accent}" Height="5" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="12" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="20" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="10" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="25" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="16" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="29" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="13" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="22" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="8" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="26" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="15" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="30" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="11" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="23" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="8" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="18" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="26" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="12" VerticalAlignment="Bottom"/><Rectangle Fill="{DynamicResource Accent}" Height="6" VerticalAlignment="Bottom"/></UniformGrid></Border>
                    <Border x:Name="EqualizerCard" Background="{DynamicResource SurfaceBg}" CornerRadius="13" Padding="9" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Equalizador" FontSize="14" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="⌃" Padding="5,1" Click="ShowEqualizer_Click"/></DockPanel><Grid Grid.Row="1" Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Preset" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="PresetCombo" Grid.Column="1" Height="27" SelectionChanged="Preset_Changed"><ComboBoxItem Content="Manual"/><ComboBoxItem Content="Flat"/><ComboBoxItem Content="Bass Boost"/><ComboBoxItem Content="Rock"/><ComboBoxItem Content="Pop"/></ComboBox></Grid><WrapPanel x:Name="EqPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Row="3" Content="Salvar preset" HorizontalAlignment="Stretch" Padding="5,4" Click="SavePreset_Click"/></Grid></Border>
                    <Border Background="{DynamicResource SurfaceBg}" CornerRadius="13" Padding="10" Margin="0,8,0,0"><StackPanel><DockPanel><TextBlock Text="♫  Letras" FontWeight="Bold"/><TextBlock Text="LOCAL .LRC" DockPanel.Dock="Right" FontSize="8" Foreground="{DynamicResource SecondaryText}"/></DockPanel><TextBlock x:Name="LyricsText" Text="As letras locais (.lrc ou .txt) aparecerão aqui quando disponíveis." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="2,7,2,2"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom player -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="12,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="DockCoverBorder" Width="48" Height="48" CornerRadius="9" Background="#49306D" Margin="0,0,10,0" ClipToBounds="True"><Grid><Image x:Name="DockCover" Stretch="UniformToFill"/><TextBlock x:Name="DockCoverGlyph" Text="♫" FontSize="24" Foreground="#E6C9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="DockTrack" Text="Nenhuma faixa" FontWeight="Bold" TextTrimming="CharacterEllipsis" Width="165"/><TextBlock x:Name="DockStatus" Text="Lumina Player · Offline" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></StackPanel></StackPanel>
                <Grid Grid.Column="1" Margin="10,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="⤨" Click="Shuffle_Click"/><Button Content="|◀" FontSize="16" Click="Previous_Click"/><Button Content="▶" x:Name="DockPlayButton" Width="38" Height="38" FontSize="16" Background="{DynamicResource Accent}" Foreground="#1B1029" Click="PlayPause_Click"/><Button Content="▶|" FontSize="16" Click="Next_Click"/><Button Content="↻" Click="Loop_Click"/></StackPanel><Grid Grid.Row="1" Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="0:00" x:Name="DockElapsed" FontSize="9" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/><Slider x:Name="DockProgress" Grid.Column="1" Minimum="0" Maximum="1000" Margin="8,0" PreviewMouseLeftButtonDown="DockProgress_MouseDown" PreviewMouseLeftButtonUp="DockProgress_MouseUp" ValueChanged="DockProgress_ValueChanged"/><TextBlock Text="0:00" x:Name="DockDuration" Grid.Column="2" FontSize="9" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/></Grid></Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"><Button x:Name="MuteButton" Content="◖))" Click="Mute_Click"/><Slider x:Name="VolumeSlider" Width="105" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_ValueChanged" PreviewMouseLeftButtonUp="Volume_MouseUp"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
