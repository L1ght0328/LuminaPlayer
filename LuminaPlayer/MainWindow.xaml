<Window x:Class="LuminaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina Player" Icon="lumina.ico" Height="850" Width="1440" MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI" FontSize="13"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#101116"/>
        <SolidColorBrush x:Key="PanelBg" Color="#171922"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#202330"/>
        <SolidColorBrush x:Key="RaisedBg" Color="#292D3B"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F5F5FA"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#A7A9BA"/>
        <SolidColorBrush x:Key="Accent" Color="#A78BFA"/>
        <SolidColorBrush x:Key="Line" Color="#303444"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource RaisedBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="2,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="itemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#39314F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource RaisedBg}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="Foreground" Value="#202330"/><Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
                <Border Width="42" Height="42" CornerRadius="13" Background="#8B5CF6" Margin="0,0,12,0">
                    <TextBlock Text="L" FontSize="27" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="lumina" FontSize="24" FontWeight="Bold"/><TextBlock Text="MUSIC PLAYER" FontSize="9" Foreground="{DynamicResource SecondaryText}" FontWeight="Bold"/></StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBg}" CornerRadius="11" Height="44" VerticalAlignment="Center" Margin="0,0,16,0">
                <DockPanel><TextBlock Text="⌕" FontSize="25" Foreground="{DynamicResource SecondaryText}" Margin="13,0,8,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Background="Transparent" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Pesquisar músicas"/></DockPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="＋  Adicionar pasta" Background="{DynamicResource Accent}" Foreground="#171322" Click="AddFolder_Click" Padding="16,12"/>
                <Button Content="⚙" FontSize="17" Width="44" Click="Menu_Click" ToolTip="Configurações"/>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource PanelBg}" CornerRadius="16" Padding="13" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="SUA BIBLIOTECA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="9,8,0,10"/>
                    <StackPanel Grid.Row="1">
                        <Button Content="♫  Todas as músicas" HorizontalContentAlignment="Left" Background="#39314F" Click="AllMusic_Click"/>
                        <Button Content="▣  Pastas adicionadas" HorizontalContentAlignment="Left" Background="Transparent" Click="FocusFolders_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,22,0,0">
                        <DockPanel Margin="8,0,4,8"><TextBlock Text="PASTAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}"/><Button DockPanel.Dock="Right" Content="＋" Padding="7,3" Click="AddFolder_Click"/></DockPanel>
                        <ListBox x:Name="RootsList" MaxHeight="160" MouseDoubleClick="Root_DoubleClick"/>
                        <DockPanel Margin="8,20,4,8"><TextBlock Text="PLAYLISTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}"/><Button DockPanel.Dock="Right" Content="＋" Padding="7,3" Click="NewGroup_Click"/></DockPanel>
                        <ListBox x:Name="CollectionsList" MouseDoubleClick="Collection_DoubleClick"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3"><Button Content="＋ Nova playlist" Background="{DynamicResource RaisedBg}" Click="NewPlaylist_Click"/><Button Content="Adicionar seleção à playlist" Background="Transparent" Foreground="{DynamicResource SecondaryText}" Click="AddToPlaylist_Click"/></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource PanelBg}" CornerRadius="16" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel><StackPanel><TextBlock Text="SUA COLEÇÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Músicas" FontSize="27" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="TrackCount" DockPanel.Dock="Right" Text="0 faixas" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Bottom" Margin="0,0,5,5"/></DockPanel>
                        <Grid Grid.Row="1" Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="#" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="TÍTULO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="ARQUIVO LOCAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,15,0"/></Grid>
                        <ListBox x:Name="TracksList" Grid.Row="2" MouseDoubleClick="Track_DoubleClick" SelectionMode="Extended">
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="#30264A" HorizontalAlignment="Center"><TextBlock Text="♫" Foreground="#C4B5FD" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></StackPanel><TextBlock Grid.Column="2" Text="LOCAL" FontSize="9" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="10,0,12,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource PanelBg}" CornerRadius="16" Padding="16" x:Name="EqualizerCard">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="EQUALIZADOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="Ajuste seu som" FontSize="15" FontWeight="SemiBold"/></StackPanel>
                        <WrapPanel x:Name="EqPanel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="PresetCombo" Width="115" SelectionChanged="Preset_Changed"><ComboBoxItem Content="Manual"/><ComboBoxItem Content="Flat"/><ComboBoxItem Content="Bass Boost"/><ComboBoxItem Content="Rock"/><ComboBoxItem Content="Pop"/></ComboBox><Button Content="Salvar" Click="SavePreset_Click"/></StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Player dock -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" CornerRadius="16" Padding="17,13" Margin="0,16,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="44" Height="44" CornerRadius="10" Background="#30264A" Margin="0,0,12,0"><TextBlock Text="♫" FontSize="23" Foreground="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="NowPlaying" Text="Escolha uma música" FontWeight="Bold"/><TextBlock x:Name="StatusText" Text="Biblioteca local · Offline" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></StackPanel></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⟲" x:Name="LoopButton" Click="Loop_Click" ToolTip="Modo de repetição"/><Button Content="|◀" FontSize="17" Click="Previous_Click"/><Button x:Name="PlayButton" Content="▶" FontSize="19" Width="48" Height="43" Background="{DynamicResource Accent}" Foreground="#171322" Click="PlayPause_Click"/><Button Content="▶|" FontSize="17" Click="Next_Click"/></StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="Elapsed" Text="0:00" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/><Slider x:Name="Progress" Width="180" Minimum="0" Maximum="1000" Margin="8,0" ValueChanged="Progress_ValueChanged" PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp"/><TextBlock x:Name="Duration" Text="0:00" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/><Button x:Name="MuteButton" Content="◖))" Click="Mute_Click"/><Slider x:Name="VolumeSlider" Width="95" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_ValueChanged" PreviewMouseLeftButtonUp="Volume_MouseUp"/></StackPanel>
                </Grid>
                <Border Grid.Row="1" Height="2" Background="{DynamicResource Line}" Margin="0,13,0,0"><Border HorizontalAlignment="Left" Width="0" Background="{DynamicResource Accent}"/></Border>
            </Grid>
        </Border>
    </Grid>
</Window>
