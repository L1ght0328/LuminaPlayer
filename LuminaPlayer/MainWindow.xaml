<Window x:Class="LuminaPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumina Player" Icon="pack://application:,,,/lumina.ico"
        Height="900" Width="1540" MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI" FontSize="13"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#100D1B"/>
        <SolidColorBrush x:Key="PanelBg" Color="#E6191428"/>
        <SolidColorBrush x:Key="SurfaceBg" Color="#E6241D38"/>
        <SolidColorBrush x:Key="RaisedBg" Color="#FF30234A"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F8F5FF"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#BDB3D0"/>
        <SolidColorBrush x:Key="Accent" Color="#B65CFF"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#49306D"/>
        <SolidColorBrush x:Key="Line" Color="#49365F"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#503D6A"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.72"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="9,8"/><Setter Property="Margin" Value="2,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="itemBorder" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#593477"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#38284E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource SurfaceBg}"/><Setter Property="Foreground" Value="#241832"/><Setter Property="Padding" Value="7,4"/><Setter Property="BorderThickness" Value="0"/></Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="92"/></Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="5,0,5,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="〽" FontSize="35" Foreground="{DynamicResource Accent}" FontWeight="Bold" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="LUMINA" FontSize="21" FontWeight="Bold"/><TextBlock Text="PLAYER" FontSize="9" Foreground="{DynamicResource SecondaryText}"/></StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22" Height="42" VerticalAlignment="Center" Margin="16,0,16,0">
                <DockPanel><TextBlock Text="⌕" FontSize="25" Foreground="{DynamicResource SecondaryText}" Margin="14,0,7,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="Buscar músicas pelo nome"/></DockPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="＋ Adicionar pasta" Background="{DynamicResource Accent}" Foreground="#1B1029" Click="AddFolder_Click" Padding="15,11"/>
                <Button Content="☰" FontSize="18" Width="43" Click="Menu_Click" ToolTip="Menu e aparência"/>
            </StackPanel>
        </Grid>

        <!-- Main workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="315"/></Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="17" Padding="12" Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="BIBLIOTECA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="9,9,0,10"/>
                    <StackPanel Grid.Row="1">
                        <Button Content="♫   Minha Música" HorizontalContentAlignment="Left" Background="{DynamicResource AccentSoft}" Click="AllMusic_Click"/>
                        <Button Content="▦   Pastas" HorizontalContentAlignment="Left" Click="FocusFolders_Click"/>
                        <Button Content="≡   Playlists" HorizontalContentAlignment="Left" Click="FocusCollections_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="SUAS PASTAS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="9,22,0,6"/>
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <ListBox x:Name="RootsList" MaxHeight="145" MouseDoubleClick="Root_DoubleClick"/>
                        <ListBox x:Name="CollectionsList" Grid.Row="1" MouseDoubleClick="Collection_DoubleClick" Margin="0,8,0,0"/>
                    </Grid>
                    <StackPanel Grid.Row="4">
                        <Border Height="1" Background="{DynamicResource Line}" Margin="4,10"/>
                        <Button Content="♫   Equalizador" HorizontalContentAlignment="Left" Click="ShowEqualizer_Click"/>
                        <Button Content="◐   Aparência e fundo" HorizontalContentAlignment="Left" Click="Menu_Click"/>
                        <TextBlock Text="OFFLINE · SUA MÚSICA" FontSize="9" Foreground="{DynamicResource SecondaryText}" Margin="10,14,0,4"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Center library -->
            <Grid Grid.Column="1" Margin="0,0,10,10">
                <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="43"/><RowDefinition Height="Auto"/><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="17" Padding="25,18" Margin="0,0,0,11" ClipToBounds="True">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4D207A" Offset="0"/><GradientStop Color="#25123F" Offset="0.58"/><GradientStop Color="#171126" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Grid>
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="BOA MÚSICA, SEMPRE." FontSize="27" FontWeight="Bold"/><TextBlock Text="Sua biblioteca, do seu jeito." FontSize="15" Foreground="#D6C8E9" Margin="0,5,0,0"/></StackPanel>
                        <TextBlock Text="〽" FontSize="82" Foreground="#B85BFF" Opacity="0.8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="18" Padding="17,7" Margin="2"><TextBlock Text="Todas" FontWeight="SemiBold"/></Border>
                        <TextBlock Text="Músicas" VerticalAlignment="Center" Margin="14,0" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock Text="Pastas" VerticalAlignment="Center" Margin="14,0" Foreground="{DynamicResource SecondaryText}"/>
                    </StackPanel>
                    <TextBlock x:Name="TrackCount" Grid.Column="1" Text="0 faixas" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                </Grid>
                <Grid Grid.Row="2" Margin="2,0,2,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="SUA COLEÇÃO MUSICAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TrackPageLabel" Text="1 / 1" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="‹" Padding="8,3" Click="PreviousPage_Click" ToolTip="Página anterior"/>
                        <Button Content="›" Padding="8,3" Click="NextPage_Click" ToolTip="Próxima página"/>
                        <Button Content="＋ Pasta" Padding="8,3" Click="AddFolder_Click"/>
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="FolderTiles" Grid.Row="3" Margin="0,0,0,7">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Width="150" Height="65" Margin="3,2,7,2" Padding="10,7" Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Click="FolderTile_Click" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="▰" FontSize="27" Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Width="105"/><TextBlock Text="Pasta local" FontSize="9" Foreground="{DynamicResource SecondaryText}"/></StackPanel></StackPanel>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid Grid.Row="4">
                    <ListBox x:Name="TracksList" MouseDoubleClick="Track_DoubleClick" SelectionMode="Extended">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="5"/><Setter Property="Margin" Value="3"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="13" Padding="10" Margin="2">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="95"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border CornerRadius="10" ClipToBounds="True">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#6533A0" Offset="0"/><GradientStop Color="#251C43" Offset="1"/></LinearGradientBrush></Border.Background>
                                            <Grid><TextBlock Text="♫" FontSize="43" Foreground="#E4C8FF" Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="LOCAL AUDIO" FontSize="8" Foreground="#E8D8FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,7"/></Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="2,9,2,2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{DynamicResource SecondaryText}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Adicione uma pasta para começar a ouvir sua coleção" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="14">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=TracksList, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- Right now-playing / EQ rail -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="17" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="TOCANDO AGORA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SecondaryText}" Margin="5,5,0,12"/>
                    <StackPanel Grid.Row="1">
                        <Border Height="155" CornerRadius="13" ClipToBounds="True">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#783BC4" Offset="0"/><GradientStop Color="#26183E" Offset="0.65"/><GradientStop Color="#111827" Offset="1"/></LinearGradientBrush></Border.Background>
                            <Grid><TextBlock Text="〽" FontSize="78" Foreground="#E1B9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="LUMINA PLAYER" FontSize="9" Foreground="#EBD9FF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"/></Grid>
                        </Border>
                        <TextBlock x:Name="NowPlaying" Text="Escolha uma música" FontSize="18" FontWeight="Bold" Margin="2,12,2,1" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="StatusText" Text="Sua biblioteca local · Offline" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="2,0,2,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2">
                        <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Elapsed" Text="0:00" FontSize="10" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="Duration" Grid.Column="1" Text="0:00" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></Grid>
                        <Slider x:Name="Progress" Minimum="0" Maximum="1000" ValueChanged="Progress_ValueChanged" PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp" Margin="0,0,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="⤨" Click="Shuffle_Click" ToolTip="Embaralhar"/><Button Grid.Column="1" Content="|◀" FontSize="17" Click="Previous_Click"/><Button Grid.Column="2" x:Name="PlayButton" Content="▶" FontSize="19" Width="43" Height="43" Background="{DynamicResource Accent}" Foreground="#1B1029" Click="PlayPause_Click"/><Button Grid.Column="3" Content="▶|" FontSize="17" Click="Next_Click"/><Button Grid.Column="4" x:Name="LoopButton" Content="↻" Click="Loop_Click" ToolTip="Repetir"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <Border x:Name="EqualizerCard" Background="{DynamicResource SurfaceBg}" CornerRadius="13" Padding="9" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <DockPanel><TextBlock Text="Equalizador" FontSize="14" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="⌃" Padding="5,1" Click="ShowEqualizer_Click"/></DockPanel>
                                <Grid Grid.Row="1" Margin="0,8,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Preset" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox x:Name="PresetCombo" Grid.Column="1" Height="28" SelectionChanged="Preset_Changed"><ComboBoxItem Content="Manual"/><ComboBoxItem Content="Flat"/><ComboBoxItem Content="Bass Boost"/><ComboBoxItem Content="Rock"/><ComboBoxItem Content="Pop"/></ComboBox></Grid>
                                <WrapPanel x:Name="EqPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Button Grid.Row="3" Content="Salvar preset" HorizontalAlignment="Stretch" Padding="6,5" Click="SavePreset_Click"/>
                            </Grid>
                        </Border>
                        <Border Background="{DynamicResource SurfaceBg}" CornerRadius="13" Padding="12" Margin="0,10,0,0">
                            <StackPanel><TextBlock Text="Sua música, sem distrações" FontWeight="SemiBold"/><TextBlock Text="Reprodução local, sem anúncios ou conexão com a internet." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Persistent bottom transport bar -->
        <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="10" Background="#49306D" Margin="0,0,11,0"><TextBlock Text="♫" FontSize="25" Foreground="#E6C9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="DockTrack" Text="Nenhuma faixa" FontWeight="Bold" TextTrimming="CharacterEllipsis" Width="175"/><TextBlock x:Name="DockStatus" Text="Lumina Player · Offline" FontSize="10" Foreground="{DynamicResource SecondaryText}"/></StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Margin="12,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="⤨" Click="Shuffle_Click"/><Button Content="|◀" FontSize="16" Click="Previous_Click"/><Button Content="▶" x:Name="DockPlayButton" Width="38" Height="38" FontSize="16" Background="{DynamicResource Accent}" Foreground="#1B1029" Click="PlayPause_Click"/><Button Content="▶|" FontSize="16" Click="Next_Click"/><Button Content="↻" Click="Loop_Click"/></StackPanel>
                    <Grid Grid.Row="1" Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="0:00" x:Name="DockElapsed" FontSize="9" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/><Slider x:Name="DockProgress" Grid.Column="1" Minimum="0" Maximum="1000" Margin="8,0" IsEnabled="False"/><TextBlock Text="0:00" x:Name="DockDuration" Grid.Column="2" FontSize="9" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/></Grid>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"><Button x:Name="MuteButton" Content="◖))" Click="Mute_Click"/><Slider x:Name="VolumeSlider" Width="112" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_ValueChanged" PreviewMouseLeftButtonUp="Volume_MouseUp"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
