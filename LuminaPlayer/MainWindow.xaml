<Window x:Class="LuminaPlayer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Lumina Player" Height="790" Width="1180" MinHeight="650" MinWidth="900"
 WindowStartupLocation="CenterScreen" Background="#171922">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Background" Value="#2A3040"/><Setter Property="Foreground" Value="#F4F4FA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#222633"/><Setter Property="Foreground" Value="#F4F4FA"/><Setter Property="BorderBrush" Value="#41485A"/><Setter Property="Padding" Value="9"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#202430"/><Setter Property="Foreground" Value="#F4F4FA"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="2"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="#8B7CFF"/></Style>
  <Style TargetType="GroupBox"><Setter Property="Foreground" Value="#DADBE5"/><Setter Property="BorderBrush" Value="#3B4150"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,8,0,0"/></Style>
 </Window.Resources>
 <DockPanel Margin="18">
  <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="LUMINA" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,22,0"/>
   <TextBox x:Name="SearchBox" Grid.Column="1" Height="36" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal">
    <Button Content="+ Adicionar pasta" Click="AddFolder_Click"/>
    <Button Content="☰ Menu" Click="Menu_Click"/>
   </StackPanel>
  </Grid>
  <GroupBox DockPanel.Dock="Bottom" Header="TOCANDO AGORA" Margin="0,12,0,0">
   <StackPanel>
    <TextBlock x:Name="NowPlaying" Text="Escolha uma música para começar" Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
    <Slider x:Name="Progress" Minimum="0" Maximum="1000" ValueChanged="Progress_ValueChanged" PreviewMouseLeftButtonDown="Progress_MouseDown" PreviewMouseLeftButtonUp="Progress_MouseUp"/>
    <DockPanel Margin="2,0,2,5"><TextBlock x:Name="Elapsed" Text="0:00" Foreground="#B8BAC7"/><TextBlock x:Name="Duration" Text="0:00" Foreground="#B8BAC7" DockPanel.Dock="Right"/></DockPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
     <Button x:Name="LoopButton" Content="Loop: desligado" Click="Loop_Click"/>
     <Button Content="⏮" FontSize="18" Click="Previous_Click"/>
     <Button x:Name="PlayButton" Content="▶" FontSize="18" Background="#8B7CFF" Click="PlayPause_Click" Width="65"/>
     <Button Content="⏭" FontSize="18" Click="Next_Click"/>
     <Button x:Name="MuteButton" Content="Mudo" Click="Mute_Click"/>
     <TextBlock Text="Volume" Foreground="#DADBE5" VerticalAlignment="Center" Margin="8,0"/>
     <Slider x:Name="VolumeSlider" Width="130" Minimum="0" Maximum="100" Value="75" ValueChanged="Volume_ValueChanged"/>
    </StackPanel>
   </StackPanel>
  </GroupBox>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Margin="0,0,12,0">
    <GroupBox x:Name="LibraryGroup" Header="PASTAS DO COMPUTADOR">
     <ListBox x:Name="RootsList" Height="150" MouseDoubleClick="Root_DoubleClick"/>
    </GroupBox>
    <GroupBox x:Name="PlaylistsGroup" Header="CATEGORIAS E PLAYLISTS">
     <StackPanel>
      <ListBox x:Name="CollectionsList" Height="220" MouseDoubleClick="Collection_DoubleClick"/>
      <WrapPanel><Button Content="+ Categoria" Click="NewGroup_Click"/><Button Content="Renomear" Click="RenameGroup_Click"/><Button Content="+ Playlist" Click="NewPlaylist_Click"/></WrapPanel>
      <Button Content="Adicionar seleção à playlist" Click="AddToPlaylist_Click"/>
     </StackPanel>
    </GroupBox>
   </StackPanel>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <GroupBox Header="BIBLIOTECA MUSICAL">
     <ListBox x:Name="TracksList" MouseDoubleClick="Track_DoubleClick" SelectionMode="Extended"/>
    </GroupBox>
    <GroupBox x:Name="EqualizerGroup" Grid.Row="1" Header="MIX / EQUALIZADOR">
     <StackPanel>
      <DockPanel><TextBlock Text="Preset" Foreground="#DADBE5" VerticalAlignment="Center"/><ComboBox x:Name="PresetCombo" Width="180" Margin="8,0" SelectionChanged="Preset_Changed"><ComboBoxItem Content="Manual"/><ComboBoxItem Content="Flat"/><ComboBoxItem Content="Bass Boost"/><ComboBoxItem Content="Rock"/><ComboBoxItem Content="Pop"/></ComboBox><Button Content="Salvar preset" Click="SavePreset_Click"/></DockPanel>
      <WrapPanel x:Name="EqPanel" Orientation="Horizontal"/>
     </StackPanel>
    </GroupBox>
   </Grid>
  </Grid>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Text="Offline · Biblioteca local" Foreground="#9DA2B3" Margin="0,8,0,0"/>
 </DockPanel>
</Window>
